// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rule {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  description      String?
  source           String
  metric           String
  windowSeconds    Int      @map("window_seconds")
  thresholdExpr    String   @map("threshold_expr")
  severityFormula  String   @map("severity_formula")
  channelTarget    String   @map("channel_target")
  mentionList      Json     @map("mention_list") // Lưu dạng string array
  templateId       String   @map("template_id")
  buttons          Json     // Mảng các button configuration
  escalationPolicy Json     @map("escalation_policy") // Cấu hình logic leo thang
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  alerts           Alert[]

  @@map("rules")
}

model Alert {
  id             String    @id @default(uuid()) @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  severity       String    // P1, P2, P3
  status         String    // OPEN, ACK, RESOLVED, ESCALATED
  entityId       String    @map("entity_id")
  payload        Json      // Lưu dữ liệu anomaly chi tiết
  channelMsgRef  String?   @map("channel_msg_ref") // Message TS/ID trên Slack/Teams
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  ackAt          DateTime? @map("ack_at") @db.Timestamptz()
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz()
  escalatedAt    DateTime? @map("escalated_at") @db.Timestamptz()
  mttrSeconds    Int?      @map("mttr_seconds")

  rule           Rule      @relation(fields: [ruleId], references: [id])
  auditLogs      AuditLog[]

  @@index([ruleId, entityId, createdAt(sort: Desc)]) // Tối ưu việc check deduplication trong 15 phút
  @@map("alerts")
}

model AuditLog {
  eventId   String   @id @default(uuid()) @map("event_id") @db.Uuid
  alertId   String   @map("alert_id") @db.Uuid
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  action    String
  payload   Json?
  tsGmt7    DateTime @default(now()) @map("ts_gmt7") @db.Timestamptz()

  alert     Alert    @relation(fields: [alertId], references: [id])

  @@map("audit_log")
}

model Shift {
  id      String   @id @default(uuid()) @db.Uuid
  team    String
  userId  String   @map("user_id")
  channel String
  startAt DateTime @map("start_at") @db.Timestamptz()
  endAt   DateTime @map("end_at") @db.Timestamptz()

  @@map("shifts")
}

model User {
  id       String  @id // Khóa chính mapping với hệ thống internal (VD: email prefix)
  name     String
  email    String  @unique
  role     String  // executor, leader, ceo
  team     String  // Online, CS, Offline, Logistics
  slackId  String? @map("slack_id")
  teamsId  String? @map("teams_id")
  zaloId   String? @map("zalo_id")

  @@map("users")
}
